    "version": "0.2.0",
    "configurations": [
        {
            "type": "probe-rs-debug",
            "request": "launch",
            "name": "debug with probe-rs",
            "cwd": "${workspaceRoot}",
            "connectUnderReset": false,
            "chip": "GD32F470VG",
            "flashingConfig": {
                "flashingEnabled": true,
                "verifyBeforeFlashing": true,
                "verifyAfterFlashing": true,
                "haltAfterReset": true,
                "formatOptions": {
                    "binaryFormat": "elf"
                }
            },
            "coreConfigs": [
                {
                    "coreIndex": 0,
                    "programBinary": "./build/gd32f470_blink.elf"
                }
            ]
        }
    ]
}